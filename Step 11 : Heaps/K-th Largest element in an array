class Solution {
    public int findKthLargest(int[] nums, int k) {


        MaxHeap heap = new MaxHeap(nums.length);

        // insert all elements
        for (int num : nums) {
            heap.insert(num);
        }

        // remove k-1 largest
        for (int i = 1; i < k; i++) {
            heap.remove();
        }

        return heap.remove();
      
    }
}

class MaxHeap {

    int[] heap;
    int size;

    MaxHeap(int capacity){
        heap = new int[capacity];
        size = 0;
    }

    private int parent(int i){
        return(i - 1) /2;
    }

    private int left(int i){
        return 2 * i +1;
    }

    private int right(int i) {
        return 2 * i + 2;
    }

    public void insert(int value){
        heap[size] = value;
        int index = size;
        size++;

        while(index > 0 && heap[index] > heap[parent(index)]){
             int temp = heap[index];
            heap[index] = heap[parent(index)];
            heap[parent(index)] = temp;

              index = parent(index);
        }
    }
 public int remove() {

        if (size == 0) {
            return -1;
        }

        int max = heap[0];

        heap[0] = heap[size - 1];
        size--;

        heapifyDown(0);

        return max;
    }


    private void heapifyDown(int index) {

        while (true) {

            int largest = index;
            int l = left(index);
            int r = right(index);


            if (l < size && heap[l] > heap[largest]) {
                largest = l;
            }

            if (r < size && heap[r] > heap[largest]) {
                largest = r;
            }


            if (largest == index) {
                break;
            }


            int temp = heap[index];
            heap[index] = heap[largest];
            heap[largest] = temp;

            index = largest;
        }
    }
}
